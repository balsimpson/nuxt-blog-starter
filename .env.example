# Clerk authentication used by Nuxt
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
NUXT_CLERK_SECRET_KEY=sk_test_your_key

# Convex deployment used by Nuxt
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional article-generation services
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
TAVILY_API_KEY=
